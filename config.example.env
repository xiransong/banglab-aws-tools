# banglab-aws-tools local configuration
#
# Copy this file to config.env:
#
#   make init-config
#
# Then edit the user-specific values below.

###############################################################################
# User-specific values
###############################################################################

# Your BangLab username / AWS Owner value.
OWNER=takishiina

# Local AWS CLI profile name. Usually set this to the same value as OWNER.
AWS_PROFILE=takishiina

# Human-readable AWS account label from AWS Access Portal.
AWS_ACCOUNT_LABEL=xiransong

# 12-digit AWS account ID from AWS Access Portal.
AWS_ACCOUNT_ID=777712053059

###############################################################################
# BangLab defaults
###############################################################################

AWS_REGION=us-east-1
AWS_SSO_START_URL=https://banglab-udem-mila.awsapps.com/start
AWS_SSO_REGION=us-east-1
AWS_SSO_ROLE_NAME=EC2-GPU-Operator
AWS_SSO_SESSION=banglab
DEFAULT_AVAILABILITY_ZONE=us-east-1a
